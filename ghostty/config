theme = iTerm2 Solarized Dark
cursor-color = #ff8700

# Make split dividers clearer
split-divider-color = #657b83
unfocused-split-opacity = 0.85

# Breathing room inside each pane
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

# Behavior
scrollback-limit = 1000000000
macos-option-as-alt = left

# Keybinds
keybind = shift+enter=text:\n
