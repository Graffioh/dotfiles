theme = iTerm2 Solarized Dark
cursor-color = #ff8700

# Differentiate panes: keep the divider, dim inactive panes slightly toward the bg
split-divider-color = #657b83
unfocused-split-opacity = 0.75
unfocused-split-fill = #002b36

# Breathing room inside each pane (wider gutter separates splits more)
window-padding-x = 10
window-padding-y = 5
window-padding-balance = true

# Behavior
scrollback-limit = 1000000000
macos-option-as-alt = left

# Keybinds
keybind = shift+enter=text:\n
